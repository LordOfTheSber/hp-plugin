{
  "name": "hp-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Браузерное расширение: оформление сайтов в стиле факультетов Хогвартса",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "icons": "node scripts/build-icons.js",
    "screenshots": "node scripts/screenshots.js",
    "pack": "mkdir -p dist && cd extension && zip -qr ../dist/hp-theme-$npm_package_version.zip . -x '.*'"
  }
}
