{
  "name": "obsidian-hp-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Obsidian plugin: Hogwarts house themes with readable typography and easter eggs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node scripts/build.mjs && node --test tests/e2e/*.test.mjs",
    "mockups": "node scripts/build.mjs --mockups-only && node scripts/shoot-mockups.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.6.3"
  }
}
